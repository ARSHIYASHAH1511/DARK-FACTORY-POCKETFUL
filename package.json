{
  "name": "dark-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && tsx server.ts",
    "serve": "tsx server.ts",
    "dev": "vite",
    "typecheck": "tsc -p . && tsc -p stage-1 && tsc -p stage-2 && tsc -p stage-3 && tsc -p stage-4",
    "test:stage-1": "node stage-1/src/test.ts",
    "test:stage-2": "node stage-2/src/test.ts",
    "test:stage-3": "node stage-3/src/test.ts",
    "test:stage-4": "node stage-4/src/test.ts",
    "stress": "node stage-2/src/stress-test.ts",
    "test": "npm run test:stage-1 && npm run test:stage-2 && npm run test:stage-3 && npm run test:stage-4 && npm run stress"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
